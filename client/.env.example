# Public vars only — never put API keys or JWT secrets in NEXT_PUBLIC_* (they ship to the browser).
# Never commit a filled `.env.local` with secrets.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional — mirrors the server allow-list to give users immediate UX
# feedback on the email field. Leave empty to defer to server-side errors.
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAINS=iitb.ac.in,iitm.ac.in,iitd.ac.in,cgc.edu.in

# === Runtime ===
NODE_ENV=development
PORT=4000

# === Web client origin (CORS) ===
CLIENT_ORIGIN=http://localhost:3000

# === Database ===
MONGODB_URI=mongodb://127.0.0.1:27017/hostely

# === JWT ===
# Generate a strong secret, e.g.: `openssl rand -hex 48`
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# === Bcrypt ===
BCRYPT_SALT_ROUNDS=12

# === Session cookie ===
# Lifetime of the HTTP-only session cookie, in seconds (default 7 days).
SESSION_MAX_AGE_SECONDS=604800

# === Registration policy ===
# Comma-separated list of accepted email domains for signup.
# Examples: iitb.ac.in,iitm.ac.in,iitd.ac.in
COLLEGE_EMAIL_DOMAINS=iitb.ac.in,iitm.ac.in,iitd.ac.in

# === Cloudinary ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

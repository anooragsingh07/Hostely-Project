{
  "name": "@hostely/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and constants for Hostely",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
